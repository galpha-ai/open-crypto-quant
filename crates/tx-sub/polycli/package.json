{
  "name": "polymarket-cli",
  "version": "0.1.0",
  "description": "CLI tool for testing Polymarket APIs and learning about markets, events, and tags",
  "module": "src/index.ts",
  "type": "module",
  "private": true,
  "bin": {
    "polymarket-cli": "./bin/polymarket-cli"
  },
  "scripts": {
    "dev": "bun run src/index.ts",
    "build": "bun build src/index.ts --compile --outfile polymarket-cli",
    "start": "bun run bin/polymarket-cli",
    "test": "bun test",
    "test:watch": "bun test --watch",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "format": "prettier --write \"src/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\"",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/ws": "^8.18.1",
    "@typescript-eslint/eslint-plugin": "^8.47.0",
    "@typescript-eslint/parser": "^8.47.0",
    "eslint": "^9.39.1",
    "prettier": "^3.6.2"
  },
  "peerDependencies": {
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "chalk": "^5.6.2",
    "cli-table3": "^0.6.5",
    "commander": "^14.0.2",
    "ws": "^8.18.3",
    "yaml": "^2.8.1"
  }
}
