# Multi-stage build for Rust tx-sub service using cargo-chef
FROM lukemathwalker/cargo-chef:latest-rust-1.87-slim AS chef
WORKDIR /app

# Install required system dependencies
RUN apt-get update && apt-get install -y \
    pkg-config \
    libssl-dev \
    ca-certificates \
    build-essential \
    && rm -rf /var/lib/apt/lists/*

# Plan stage - prepare the recipe for dependency caching
FROM chef AS planner
COPY . .
RUN cargo chef prepare --recipe-path recipe.json

# Build stage - build dependencies and then the application
FROM chef AS builder

# Copy the recipe and build dependencies (this layer will be cached)
COPY --from=planner /app/recipe.json recipe.json

# Build dependencies
RUN cargo chef cook --release --recipe-path recipe.json

# Copy the source code and build the application
COPY . .
RUN cargo build --release -p solana-sub

# Runtime stage - use a minimal base image
FROM debian:bookworm-slim

# Install runtime dependencies
RUN apt-get update && apt-get install -y \
    ca-certificates \
    libssl3 \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Create a non-root user
RUN useradd --create-home --shell /bin/bash app

# Set working directory
WORKDIR /app

# Copy the built binary from builder stage
COPY --from=builder /app/target/release/solana-sub /usr/local/bin/solana-sub

# Make sure the binary is executable
RUN chmod +x /usr/local/bin/solana-sub

# Change ownership of the app directory
RUN chown -R app:app /app

# Switch to non-root user
USER app

# Expose the port for metrics (adjust based on your config)
EXPOSE 9094

# Health check (assumes metrics endpoint on port 9094)
HEALTHCHECK --interval=30s --timeout=3s --start-period=5s --retries=3 \
    CMD curl -f http://localhost:9094/metrics || exit 1

# Set the entrypoint
ENTRYPOINT ["/usr/local/bin/solana-sub"]

# Default command (config file path should be provided at runtime)
CMD ["-c", "/app/config.yaml"]