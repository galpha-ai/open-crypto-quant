# Local build variant - uses SSH agent forwarding for private deps + China mirrors
# Usage: DOCKER_BUILDKIT=1 docker build --ssh default -f Dockerfile.local -t ingester:<tag> .
FROM lukemathwalker/cargo-chef:latest-rust-1.87-slim AS chef
WORKDIR /app

# Use USTC mirror for apt
RUN sed -i 's|deb.debian.org|mirrors.ustc.edu.cn|g' /etc/apt/sources.list.d/debian.sources && \
    apt-get update && apt-get install -y \
    pkg-config \
    libssl-dev \
    ca-certificates \
    build-essential \
    git \
    openssh-client \
    && rm -rf /var/lib/apt/lists/*

# Use USTC mirror for rustup/crates.io
ENV RUSTUP_DIST_SERVER=https://mirrors.ustc.edu.cn/rust-static
ENV RUSTUP_UPDATE_ROOT=https://mirrors.ustc.edu.cn/rust-static/rustup
RUN rustup toolchain install nightly && rustup default nightly

# Use rsproxy for cargo registry
RUN cat > $CARGO_HOME/config.toml <<'EOF'
[source.crates-io]
replace-with = "rsproxy-sparse"

[source.rsproxy-sparse]
registry = "sparse+https://rsproxy.cn/index/"

[registries.rsproxy]
index = "https://rsproxy.cn/crate-index/"

[net]
git-fetch-with-cli = true
EOF

# Plan stage
FROM chef AS planner
COPY . .
RUN cargo chef prepare --recipe-path recipe.json

# Build stage
FROM chef AS builder

COPY --from=planner /app/recipe.json recipe.json

RUN --mount=type=ssh \
    mkdir -p /root/.ssh && \
    ssh-keyscan github.com >> /root/.ssh/known_hosts && \
    cargo chef cook --release --recipe-path recipe.json

COPY . .
RUN --mount=type=ssh \
    cargo build --release -p ingester

# Runtime stage
FROM debian:bookworm-slim

RUN sed -i 's|deb.debian.org|mirrors.ustc.edu.cn|g' /etc/apt/sources.list.d/debian.sources && \
    apt-get update && apt-get install -y \
    ca-certificates \
    libssl3 \
    && rm -rf /var/lib/apt/lists/*

RUN useradd --create-home --shell /bin/bash app
WORKDIR /app

COPY --from=builder /app/target/release/ingester /usr/local/bin/ingester
RUN chmod +x /usr/local/bin/ingester
RUN chown -R app:app /app

USER app

ENTRYPOINT ["/usr/local/bin/ingester"]
CMD ["--config", "/app/config.yaml"]
